license="MIT"
homepage="https://github.com/VSCodium/vscodium"
nostrip_files="linux-test-proxy lxc-exec apply-seccomp"
case "$XBPS_TARGET_MACHINE" in
	x86_64)
		_arch="x64"
    checksum=adf3548df055d18e476cdee887488ba7486b879ad99a31a546c6b5c5ff296c24
    skiprdeps="/usr/lib/vscodium-bin/resources/app/node_modules/@microsoft/mxc-sdk/bin/arm64/linux-test-proxy /usr/lib/vscodium-bin/resources/app/node_modules/@microsoft/mxc-sdk/bin/arm64/lxc-exec /usr/lib/vscodium-bin/resources/app/node_modules/@vscode/sandbox-runtime/vendor/seccomp/arm64/apply-seccomp"
		;;
	aarch64)
		_arch="arm64"
		checksum=73d87d46d4dc208fe12c0497dc607aab0a6e2bf332f54a0b6826a3a1aa32bc34
		skiprdeps="/usr/lib/vscodium-bin/resources/app/node_modules/@microsoft/mxc-sdk/bin/x64/linux-test-proxy /usr/lib/vscodium-bin/resources/app/node_modules/@microsoft/mxc-sdk/bin/x64/lxc-exec /usr/lib/vscodium-bin/resources/app/node_modules/@vscode/sandbox-runtime/vendor/seccomp/x64/apply-seccomp"
