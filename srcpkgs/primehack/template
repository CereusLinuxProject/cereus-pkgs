post_extract() {
	vsrcextract -C Externals/VulkanMemoryAllocator vma-${_vma_commit}.tar.gz
	vsrcextract -C Externals/cubeb/cubeb cubeb-${_cubeb_commit}.tar.gz
	vsrcextract -C Externals/cubeb/cubeb/cmake/sanitizers-cmake \
		sanitizers-cmake-${_sanitizers_cmake_commit}.tar.gz
	vsrcextract -C Externals/fmt/fmt fmt-${_fmt_commit}.tar.gz
	vsrcextract -C Externals/gtest googletest-${_googletest_commit}.tar.gz
	vsrcextract -C Externals/implot/implot implot-${_implot_commit}.tar.gz
	vsrcextract -C Externals/libspng/libspng libspng-${_libspng_commit}.tar.gz
	vsrcextract -C Externals/mGBA/mgba mgba-${_mgba_commit}.tar.gz
	vsrcextract -C Externals/minizip-ng/minizip-ng minizip-ng-${_minizip_ng_commit}.tar.gz
	vsrcextract -C Externals/rcheevos/rcheevos rcheevos-${_rcheevos_commit}.tar.gz
	vsrcextract -C Externals/spirv_cross/SPIRV-Cross \
		spirv-cross-${_spirv_cross_commit}.tar.gz
	vsrcextract -C Externals/tinygltf/tinygltf tinygltf-${_tinygltf_commit}.tar.gz
	vsrcextract -C Externals/zlib-ng/zlib-ng zlib-ng-${_zlib_ng_commit}.tar.gz
	vsrcextract -C Externals/cpp-ipc/cpp-ipc cpp-ipc-${_cpp_ipc_commit}.tar.gz
	vsrcextract -C Externals/SFML/SFML sfml-${_sfml_commit}.tar.gz
	vsrcextract -C Externals/cpp-optparse/cpp-optparse \
		cpp-optparse-${_cpp_optparse_commit}.tar.gz
	vsrcextract -C Externals/imgui/imgui imgui-${_imgui_commit}.tar.gz
	vsrcextract -C Externals/watcher/watcher watcher-${_watcher_commit}.tar.gz
	cp -r Externals/gtest/* Externals/cubeb/cubeb/googletest
}

post_install() {
	vinstall Data/51-usb-device.rules 644 usr/lib/udev/rules.d 51-usb-device-primehack.rules
}
