# Template file for 'touche'
pkgname=touche
version=2.0.15
revision=1
build_style=meson
build_helper="gir"
hostmakedepends="cmake pkg-config gettext-devel desktop-file-utils gjs nodejs
 glib-devel"
makedepends="appstream-glib-devel libadwaita-devel"
depends="touchegg gjs"
short_desc="Desktop application to configure Touchégg"
maintainer="Kevin Figueroa <kfdevart@disroot.org>"
license="GPL-3.0-or-later"
homepage="https://github.com/JoseExposito/touche"
changelog="${homepage}/releases/tag/${version}"
distfiles="${homepage}/archive/${version}.tar.gz"
checksum=e9e5eaed3e92bdd341acaeb0c4296f52464e6bb57dc34265c1a689c92e8439de
repository=cereus-extra

pre_build() {
	npm install
}

post_install() {
	ln -rfs ${DESTDIR}/usr/bin/com.github.joseexposito.${pkgname} \
		${DESTDIR}/usr/bin/${pkgname}
}

libtouche_package() {
	short_desc+=" - runtime library"
	pkg_install() {
		vmove usr/lib/libtouche.so.0
	}
}

touche-devel_package() {
	depends="libtouche>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/"*.so"
		vmove usr/share/gir-1.0
	}
}
